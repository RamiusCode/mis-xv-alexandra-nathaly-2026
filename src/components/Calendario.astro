---
// Calendario.astro
// Fecha según información.txt: sábado 17/10/2026
const DIA_ESPECIAL = 17;
const MES_ESPECIAL = 10; // 1-12
const AÑO_ESPECIAL = 2026;

const NOMBRES_MESES = [
  "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio",
  "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre",
];

const primerDia = new Date(AÑO_ESPECIAL, MES_ESPECIAL - 1, 1).getDay(); // 0 = domingo
const ultimoDia = new Date(AÑO_ESPECIAL, MES_ESPECIAL, 0).getDate();
const casillas = [
  ...Array(primerDia).fill(null),
  ...Array.from({ length: ultimoDia }, (_, i) => i + 1),
];
---

<section class="seccion seccion-suave">
  <div class="revelar">
    <p class="etiqueta">{AÑO_ESPECIAL}</p>
    <h2 class="titulo-seccion mt-1">{NOMBRES_MESES[MES_ESPECIAL - 1]}</h2>
    <div class="separador-plata mt-3 mb-8" aria-hidden="true">✦</div>

    <div class="tarjeta">
      <div class="grid grid-cols-7 gap-1 mb-3">
        {["D", "L", "M", "M", "J", "V", "S"].map((d) => (
          <span class="etiqueta tracking-[0.15em] text-[#7c6fc6]">{d}</span>
        ))}
      </div>
      <div class="h-px bg-[#e4e4ee] mb-3"></div>

      <div class="grid grid-cols-7 gap-1">
        {casillas.map((dia) =>
          dia === DIA_ESPECIAL ? (
            <div class="aspect-square flex items-center justify-center">
              <span class="dia-especial">{dia}</span>
            </div>
          ) : (
            <div class="aspect-square flex items-center justify-center">
              <span class="texto text-lg text-[#6b6c95]">{dia}</span>
            </div>
          ),
        )}
      </div>
    </div>
  </div>
</section>

<script>
  import "../scripts/revelar";
</script>

<style>
  .dia-especial {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 9999px;
    font-family: "Cormorant Garamond", serif;
    font-variant-numeric: lining-nums;
    font-size: 1.35rem;
    color: #ffffff;
    background-image: linear-gradient(135deg, #3e3f91, #7c6fc6);
    box-shadow:
      0 0 0 3px #ffffff,
      0 0 0 4px #c9c9d8,
      0 6px 14px rgba(62, 63, 145, 0.25);
  }
</style>
